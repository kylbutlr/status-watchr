# Neon pooled connection string for Netlify Functions or local Netlify Dev.
DATABASE_URL=
WATCHR_ACCESS_PASSWORD=
WATCHR_SESSION_SECRET=
WATCHR_INGEST_TOKEN=
# Server-only Web Push configuration. Never use a VITE_ prefix for credentials.
WATCHR_VAPID_PUBLIC_KEY=
WATCHR_VAPID_PRIVATE_KEY=
# A contact mailto: URL or HTTPS URL controlled by the owner.
WATCHR_VAPID_SUBJECT=
STATUS_WATCHR_URL=https://statuswatchr.netlify.app
CODEX_BIN=codex
STATUS_WATCHR_INTERVAL=15s

# Optional App Switchr integration. Both values must be set together, server-only.
# Service URL: https://kylbutlr-switchr.netlify.app/api/work-state
APP_SWITCHR_URL=
APP_SWITCHR_READER_TOKEN=
