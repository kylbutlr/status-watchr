# Standalone server. Copy to .env only if it does not already exist.
# password is the default; none is an explicit loopback-only choice.
WATCHR_AUTH_MODE=password
WATCHR_ACCESS_PASSWORD=
WATCHR_PORT=4288
WATCHR_ORIGIN=http://127.0.0.1:4288
WATCHR_DATA_DIR=data
# Session, ingestion, and VAPID secrets are generated under the data directory.
# Advanced installs may override the following server-only values.
WATCHR_SESSION_SECRET=
WATCHR_INGEST_TOKEN=
WATCHR_VAPID_PUBLIC_KEY=
WATCHR_VAPID_PRIVATE_KEY=
WATCHR_VAPID_SUBJECT=
# Optional hosted/legacy adapters, never required by the standalone server.
DATABASE_URL=
APP_SWITCHR_URL=
APP_SWITCHR_READER_TOKEN=
WATCHR_QUESTION_ALERTS_ENABLED=false
STATUS_WATCHR_URL=http://127.0.0.1:4288
STATUS_WATCHR_INGEST_TOKEN=
STATUS_WATCHR_INTERVAL=15s
