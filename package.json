{
  "name": "status-watchr",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1",
    "collector": "node collector/status-watchr.mjs",
    "netlify:dev": "netlify dev",
    "build:server": "node scripts/build-server.mjs",
    "build:standalone": "npm run build && npm run build:server",
    "start": "node dist/server.mjs",
    "start:local": "WATCHR_AUTH_MODE=none node dist/server.mjs",
    "package": "node scripts/package-release.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "10.7.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "Self-hosted backup alerts for selected coding-agent conversations.",
  "engines": {
    "node": ">=24.0.0"
  }
}
